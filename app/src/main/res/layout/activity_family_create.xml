<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="家人教一次"
            android:textColor="@color/primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="选个任务，生成步骤后可以逐条修改成您家的说法"
            android:textColor="@color/text_sub"
            android:textSize="15sp" />

        <!-- 页内来源标注（草稿模式用；NoActionBar 下 setTitle 无效，Toast 会消失） -->
        <TextView
            android:id="@+id/tv_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_soft"
            android:padding="10dp"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:text=""
            android:visibility="gone" />

        <!-- 生成控件：草稿模式整体隐藏，避免覆盖新草稿 -->
        <LinearLayout
            android:id="@+id/gen_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="想教什么"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="怎么称呼教的人（选填）"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_addressee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="比如：女儿、儿子、小强"
                android:textSize="18sp"
                android:maxLength="10"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_generate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_primary"
                android:text="生成步骤"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="（步骤由本地模板生成，可随意修改）"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="教程名称（最多30字）"
            android:textSize="18sp"
            android:maxLength="30"
            android:inputType="text" />

        <LinearLayout
            android:id="@+id/steps_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btn_add_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_secondary"
            android:text="＋ 再加一步"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_success"
            android:text="保存到本机"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_secondary"
            android:text="分享这份教程"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
