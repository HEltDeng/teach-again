<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="10dp" android:elevation="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
        <TextView android:id="@+id/card_drag" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:gravity="center_vertical" android:text="⠿  按住移动"
            android:textSize="13sp" android:textColor="#725F50" android:clickable="true"
            android:contentDescription="拖动步骤卡" />
        <TextView android:id="@+id/tv_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#75624F" android:layout_marginEnd="8dp" />
        <Button android:id="@+id/btn_collapse" android:layout_width="54dp" android:layout_height="36dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="收起"
            android:textSize="14sp" android:textColor="#584536" android:backgroundTint="#F1E5D4" />
    </LinearLayout>
    <TextView android:id="@+id/tv_step_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="20sp" android:textStyle="bold" android:textColor="#352B24" android:maxLines="2"
        android:ellipsize="end" android:layout_marginTop="4dp" />
    <ScrollView android:id="@+id/card_scroll" android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_marginTop="6dp" android:fillViewport="false">
        <TextView android:id="@+id/tv_step_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="#40372F" android:lineSpacingMultiplier="1.15" android:paddingBottom="4dp" />
    </ScrollView>
    <TextView android:id="@+id/tv_feedback" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#5A725B" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp">
        <Button android:id="@+id/btn_done" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="48dp"
            android:text="我做到了" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:backgroundTint="#315F4B" android:minWidth="0dp" android:padding="0dp" />
        <Button android:id="@+id/btn_repeat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:text="再说一遍" android:textSize="16sp" android:textColor="#4C3A2D" android:backgroundTint="#F1E5D4"
            android:minWidth="0dp" android:padding="0dp" android:layout_marginStart="6dp" />
        <Button android:id="@+id/btn_more" android:layout_width="42dp" android:layout_height="48dp"
            android:text="帮助" android:textSize="13sp" android:textColor="#655448" android:backgroundTint="#FFF9F0"
            android:minWidth="0dp" android:padding="0dp" android:layout_marginStart="4dp" android:contentDescription="帮助和更多操作：找不到、上一步、暂停、结束" />
    </LinearLayout>
    <LinearLayout android:id="@+id/secondary_controls" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="2dp" android:visibility="gone">
        <Button android:id="@+id/btn_help" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="找不到" android:textSize="14sp" android:textColor="#655448" android:backgroundTint="#FFF9F0"
            android:minWidth="0dp" android:padding="0dp" />
        <Button android:id="@+id/btn_prev" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="上一步" android:textSize="14sp" android:textColor="#655448" android:backgroundTint="#FFF9F0"
            android:minWidth="0dp" android:padding="0dp" />
        <Button android:id="@+id/btn_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="暂停" android:textSize="14sp" android:textColor="#655448" android:backgroundTint="#FFF9F0"
            android:minWidth="0dp" android:padding="0dp" />
        <Button android:id="@+id/btn_close" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="结束" android:textSize="14sp" android:textColor="#806459" android:backgroundTint="#FFF9F0"
            android:minWidth="0dp" android:padding="0dp" />
    </LinearLayout>
    <Button android:id="@+id/btn_ask_help" android:layout_width="match_parent" android:layout_height="44dp"
        android:visibility="gone" android:layout_marginTop="4dp"
        android:text="还是找不到？问一问" android:textSize="16sp" android:textColor="#315F4B"
        android:backgroundTint="#EAF0E7" android:minHeight="0dp" android:padding="0dp" />
</LinearLayout>
